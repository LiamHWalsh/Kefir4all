{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start kefir4all container",
            "type": "shell",
            "command": "docker start kefir4all 2>/dev/null || docker run -d --name kefir4all -p 8787:8787 -v \"${workspaceFolder}:/home/rstudio/kefir4all\" -w /home/rstudio/kefir4all -e PASSWORD=kefir4all ghcr.io/liamhwalsh/kefir4all:4.4.2-slim",
            "problemMatcher": [],
            "presentation": { "reveal": "always" }
        },
        {
            "label": "Run current R script in container",
            "type": "shell",
            "command": "RF=\"${relativeFile##*kefir4all_review_history/}\"; docker exec -w /home/rstudio/kefir4all kefir4all /opt/R/4.4.2/bin/Rscript \"$RF\"",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Interactive R in container",
            "type": "shell",
            "command": "docker exec -it -w /home/rstudio/kefir4all kefir4all /opt/R/4.4.2/bin/R --no-save",
            "problemMatcher": [],
            "presentation": { "reveal": "always" }
        }
    ]
}